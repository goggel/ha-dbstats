{
  "name": "@dbstats/backend",
  "private": true,
  "version": "1.0.0",
  "description": "dbstats for home assistant",
  "license": "MIT",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start-local-db": "DB_CONNECT_STRING=sqlite:///home/evgeny-bond/Downloads/home-assistant_v2.db npm start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/backend/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node --files -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource ormconfig.ts",
    "migrate:generate": "npm run typeorm migration:generate -n",
    "migrate:create": "npm run typeorm migration:create -n",
    "migrate:up": "npm run typeorm migration:run",
    "migrate:down": "npm run typeorm migration:revert",
    "lint:check": "eslint \"src/**/*.ts\"",
    "test:integration": "node test/integration.cjs",
    "test:aggregates": "node test/aggregates/fixture.cjs test",
    "bench:aggregates": "node test/aggregates/fixture.cjs bench"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "js-yaml": "4.3.2",
    "pg": "8.23.1",
    "rxjs": "7.8.2",
    "sqlite3": "6.0.1",
    "typeorm": "0.3.31",
    "mysql2": "3.24.6",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.13",
    "@types/node": "20.11.8",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "node-gyp": "12.4.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "express": "$express"
    },
    "express@5.3.0": {
      "body-parser": "2.4.0",
      "proxy-addr": "2.0.8"
    },
    "@nestjs/config": {
      "lodash": "4.18.1"
    },
    "@nestjs/serve-static": {
      "path-to-regexp": "8.4.2"
    },
    "sqlite3": {
      "tar": "7.5.23"
    },
    "node-gyp": {
      "tar": "7.5.23"
    },
    "prebuild-install": {
      "tar-fs": "2.1.4"
    }
  },
  "allowScripts": {
    "sqlite3": true
  }
}
